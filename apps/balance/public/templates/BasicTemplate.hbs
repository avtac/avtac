<html>

<!--
{
  "name": "Basic Template",
  "inputs": [
    {"name": "pilot-name", "label": "Pilot Name", "type": "text"}
  ]
}
-->

<head>
  <title>HTML Template</title>
  {{{defaultStyles}}}
  <style>
    body {
      margin: .25in;
    }

    table,
    th,
    td {
      border: 1px solid black;
      border-collapse: collapse;
    }

    #split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .bold {
      font-weight: bold;
    }

    .signature {
      font-family: cursive;
    }
  </style>
</head>

<body>
  <h1>Weight &amp; Balance</h1>
  <div id="split">
    <div>
      <p>Pilot Name: {{user.pilot-name}}</p>
      <p>Date Created: {{date "M/D/YY"}}</p>
      <table>
        <thead>
          <tr>
            <th></th>
            <th>Weight {{units.weightUnits}}</th>
            <th>Arm {{units.lengthUnits}}</th>
          </tr>
        </thead>
        <tbody>
          <tr class="bold">
            <td>Empty Aircraft</td>
            <td>{{emptyWeight}}</td>
            <td>{{emptyArm}}</td>
          </tr>
          <tr>
            <td>Crew Weight</td>
            <td>{{round crewWeight 1}}</td>
            <td>{{ round (getMac crewArm) 10}}</td>
          </tr>
          <tr class="bold">
            <td>Takeoff</td>
            <td>{{takeoffWeight}}</td>
            <td>{{takeoffArm}}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <div>
      <div>{{{graph (object background=false)}}}</div>
      <div>{{{diagram}}}</div>
    </div>
    <div>
      <span>Within Normal Range: </span>
      {{#if (withinRegion 'Normal' takeoffWeight takeoffArm)}}
        <span>Yes</span>
      {{else}}
        <span>No</span>
      {{/if}}
    </div>
  </div>
</body>

</html>
